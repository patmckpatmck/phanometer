# Anthropic API — https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# Reddit — read-only OAuth via a "script" app. Reddit 403s unauthenticated
# requests, so these are required for Reddit ingestion. Register an app at
# https://www.reddit.com/prefs/apps (type: script) on the free Data API tier
# (non-commercial, 100 QPM — no payment needed).
REDDIT_CLIENT_ID=...
REDDIT_CLIENT_SECRET=...
# Used only to build a descriptive User-Agent ("phanometer/1.0 by u/<name>").
REDDIT_USERNAME=your_reddit_username
